# NJH v1.5.474 사전 구성 site.env — 이 파일을 각 서버 ~/.njh-cli/site.env 로 복사
# ⛔ 채워야 하는 곳은 <REPLACE_...> 4종뿐. 나머지는 전부 확정값으로 미리 구성됨.
# 비밀값(토큰/암호)은 이 파일에 절대 쓰지 않음 — *_ENV 항목은 "환경변수 이름"만 적는 자리.

# ── 공통 (모든 서버 동일, 수정 불필요) ─────────────────────────
NJH_LLM_BASE="/data/llm"
NJH_GATEWAY_PORT="11444"
NJH_LOCAL_EMBED_MODEL="nomic-embed-text-v2-moe"
NJH_GATEWAY_TOKEN_ENV="NJH_GATEWAY_TOKEN"
NJH_EMBED_GATEWAY_TOKEN_ENV="NJH_EMBED_GATEWAY_TOKEN"
NJH_VOC_MASKING_VERIFICATION_KEY_ENV="NJH_VOC_MASKING_VERIFICATION_KEY"
# OCR 워커 3개는 게이트 호스트 loopback 고정 (수정 불필요)
NJH_OCR_BACKEND_1="127.0.0.1:8801"
NJH_OCR_BACKEND_2="127.0.0.1:8802"
NJH_OCR_BACKEND_3="127.0.0.1:8803"
NJH_OCR_GATEWAY_PORT="11446"
NJH_OCR_GATEWAY_TOKEN_ENV="NJH_OCR_GATEWAY_TOKEN"
NJH_OCR_GATEWAY_MAX_IMAGE_BYTES="25000000"
# match 는 첫 설치 지원 경로인 결정론 stub 로 시작 (실 DB 전환은 운영 후 별도)
NJH_MATCH_GATEWAY_ENGINE="stub"
NJH_MATCH_GATEWAY_PORT="8787"
NJH_MATCH_PIPELINE_OLLAMA_ENDPOINT="http://127.0.0.1:11434"
# ⚠️ match 파이프라인 모델은 "임베딩 모델"이 정답 (gemma4 아님 — 원페이지 474 표기는 결함, 아래 README 참조)
NJH_MATCH_PIPELINE_OLLAMA_MODEL="nomic-embed-text-v2-moe"
NJH_MATCH_PIPELINE_DATABASE_URL_ENV=""

# ── 바인드 주소 (기본값 그대로 사용 — 모든 인터페이스 수신, 접근통제는 CIDR+토큰이 담당) ──
# 더 조이려면 0.0.0.0 대신 "그 서버 자신의 내부 IP"로 바꿔도 됨.
NJH_GATEWAY_HOSTNAME="0.0.0.0"
NJH_EMBED_GATEWAY_HOST="0.0.0.0"
NJH_OCR_GATEWAY_HOST="0.0.0.0"
NJH_MODEL_BIND_HOST="0.0.0.0"

# ── 사이트 소유값 4종만 채우면 끝 ────────────────────────────
# 모델 서버들의 "실제" IP/호스트명 (여기엔 0.0.0.0 넣으면 안 됨 — 게이트웨이가 찾아갈 주소)
NJH_BACKEND_1="<REPLACE_AP01_호스트_또는_IP>"
NJH_BACKEND_2="<REPLACE_AP02_호스트_또는_IP>"
NJH_BACKEND_3="<REPLACE_AP03_호스트_또는_IP>"
# 게이트웨이 접속을 허용할 개발 PC 대역 (쉼표 구분)
NJH_GATEWAY_CLIENT_CIDRS="<REPLACE_승인_클라이언트_CIDR>"
